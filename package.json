{
  "name": "toolshape-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/studio run dev",
    "build": "npm --prefix apps/studio run build",
    "typecheck": "npm --prefix apps/studio run typecheck",
    "test": "npm --prefix apps/studio run test",
    "test:render-cancel": "npm --prefix apps/studio run test:render-cancel",
    "qa:browser": "npm --prefix apps/studio run qa:browser",
    "render:golden": "npm --prefix apps/studio run render:golden",
    "smoke:runtime": "npm --prefix apps/studio run smoke:runtime",
    "smoke:cli": "npm --prefix apps/studio run smoke:cli",
    "smoke:render-job": "npm --prefix apps/studio run smoke:render-job",
    "smoke:media-ingest": "npm --prefix apps/studio run smoke:media-ingest",
    "studio": "tsx packages/studio-cli/src/bin.ts",
    "mcp": "tsx packages/studio-mcp/src/bin.ts",
    "mcp:http": "tsx packages/studio-mcp/src/bin.ts --transport http --port 7777",
    "smoke:mcp": "npm --prefix apps/studio run smoke:mcp",
    "docs:screenshots": "npm --prefix apps/studio run docs:screenshots",
    "dev:connected": "npm --prefix apps/studio run dev:connected",
    "smoke:connected": "npm --prefix apps/studio run smoke:connected",
    "docs:demo": "npm --prefix apps/studio run docs:demo",
    "smoke:timeline-render": "npm --prefix apps/studio run smoke:timeline-render",
    "smoke:capture-render": "npm --prefix apps/studio run smoke:capture-render",
    "smoke:image-export": "npm --prefix apps/studio run smoke:image-export"
  }
}
