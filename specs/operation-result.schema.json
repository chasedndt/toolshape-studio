{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolshape.dev/schemas/operation-result.schema.json",
  "title": "Operation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "status",
    "trace_id",
    "state",
    "verification",
    "warnings",
    "usage",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "operation_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "trace_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "previewed",
        "completed",
        "accepted_job",
        "approval_required",
        "rejected",
        "failed",
        "partially_completed"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "revision_after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "semantic_diff": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "project": {
          "type": "object",
          "description": "Canonical project state at revision_after. Present on read capabilities and on mutations that resolved to a project. Deliberately unconstrained here: StudioProject is defined and migrated by the domain package, and duplicating its shape in this schema would create two sources of truth that drift."
        }
      }
    },
    "job_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/resource_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource_ref"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "pending",
            "not_applicable",
            "limited"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "model_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "undo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "error_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
