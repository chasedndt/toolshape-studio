{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolshape.dev/schemas/artifact.schema.json",
  "title": "Immutable artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "media_type",
    "size_bytes",
    "digest",
    "source",
    "producer",
    "sensitivity",
    "retention_class",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "logical_name": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "source": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource_ref"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "secret"
      ]
    },
    "retention_class": {
      "$ref": "common.schema.json#/$defs/retention_class"
    },
    "licence": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
