{
  "contract_version": "0.1.0",
  "application": {
    "id": "dev.toolshape.voice",
    "name": "Toolshape Voice",
    "version": "0.1.0",
    "project_schema_version": "0.1.0"
  },
  "transports": [
    "in_process_sdk",
    "local_ipc",
    "cli",
    "mcp_stdio"
  ],
  "capabilities": [
    {
      "id": "voice.transcript.apply_transform",
      "version": "0.1.0",
      "description": "Validates and applies a selected deterministic or approved model-backed transformation to one transcript revision.",
      "when_to_use": [
        "Apply a reviewed batch of structured edits."
      ],
      "when_not_to_use": [
        "Do not use for raw UI gestures or an unreviewed public publish."
      ],
      "input_schema": "operation-envelope.schema.json",
      "output_schema": "operation-result.schema.json",
      "effects": [
        "write_local_state"
      ],
      "risk": "reversible_local_write",
      "supports": {
        "dry_run": true,
        "idempotency": true,
        "batching": true,
        "cancellation": false,
        "streaming": false
      },
      "preconditions": [
        "project_exists",
        "expected_revision_matches"
      ],
      "postconditions": [
        "domain_invariants_hold"
      ],
      "authorization": {
        "required_grants": [
          "studio:project:read",
          "studio:project:write"
        ],
        "approval_mode": "policy",
        "hard_invariants": [
          "no_secret_plaintext"
        ]
      },
      "verification": {
        "mode": "deterministic",
        "verifier_id": "studio.project.invariants.v1",
        "limitations": []
      },
      "recovery": {
        "mode": "inverse_operation",
        "time_limit_seconds": 86400
      },
      "cost": {
        "billable": false,
        "estimable": true,
        "quote_capability": null
      },
      "latency_class": "interactive",
      "examples": []
    }
  ],
  "resources": [
    {
      "uri_template": "toolshape-voice://sessions/{session_id}/summary",
      "description": "Redacted dictation session summary",
      "sensitivity": "private"
    }
  ],
  "jobs": {
    "progress": true,
    "cancellation": true,
    "resumable": true
  },
  "events": [
    "voice.session.started",
    "voice.transcript.finalized",
    "job.completed"
  ],
  "security": {
    "delegated_identity": true,
    "capability_grants": true,
    "secret_handles": true,
    "data_egress_policy": true,
    "local_only_mode": true
  },
  "conformance": {
    "profile": "harness_native",
    "suite_version": "0.1.0"
  }
}
