{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolshape.dev/schemas/workflow-recipe.schema.json",
  "title": "Portable workflow recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "version",
    "name",
    "goal",
    "required_capabilities",
    "inputs",
    "steps",
    "verification",
    "retention_class"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "recipe_id": {
      "type": "string"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "name": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "on_success",
          "on_failure"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "with": {
            "type": "object"
          },
          "approval": {
            "type": "string",
            "enum": [
              "none",
              "policy",
              "explicit"
            ]
          },
          "on_success": {
            "type": [
              "string",
              "null"
            ]
          },
          "on_failure": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_class": {
      "$ref": "common.schema.json#/$defs/retention_class"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "evaluating",
        "approved",
        "deprecated"
      ]
    }
  }
}
