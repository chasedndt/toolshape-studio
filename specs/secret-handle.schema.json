{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolshape.dev/schemas/secret-handle.schema.json",
  "title": "Opaque secret handle metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle",
    "owner_principal_id",
    "purpose",
    "audiences",
    "capabilities",
    "created_at",
    "expires_at",
    "max_resolutions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "handle": {
      "type": "string",
      "pattern": "^secret://[A-Za-z0-9/_-]+$"
    },
    "owner_principal_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "target_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource_ref"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "max_resolutions": {
      "type": "integer",
      "minimum": 1
    },
    "resolution_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked",
        "consumed"
      ]
    },
    "retention_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
